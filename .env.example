# Jarvis 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
JARVIS_HOST=127.0.0.1
JARVIS_PORT=7437

# ── Logging ───────────────────────────────────────────────────
JARVIS_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
JARVIS_LOG_FILE=~/.jarvis/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
JARVIS_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# JARVIS_CONFIG=~/.jarvis/config.toml
# 通常由 `jarvis` 根据当前目录自动设置，无需手工配置
# JARVIS_WORKSPACE_ROOT=D:\path\to\project

# ── LLM ───────────────────────────────────────────────────────
# DeepSeek（推荐）
JARVIS_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
JARVIS_LLM_DEFAULT_MODEL=deepseek-flash
# 默认：https://api.deepseek.com/anthropic
# JARVIS_LLM_BASE_URL=https://api.deepseek.com/anthropic

# Anthropic（改用 Claude 时启用）
# JARVIS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# JARVIS_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# JARVIS_LLM_BASE_URL=https://api.anthropic.com

# OpenAI Responses 中转（也可保留 DeepSeek 默认值，通过命名模型切换）
# JARVIS_LLM_PROVIDER=openai
# JARVIS_LLM_DEFAULT_MODEL=gpt-6.1-sol
# JARVIS_LLM_BASE_URL=https://hk.testvideo.site/v1
# OPENAI_API_KEY=中转服务的密钥
# JARVIS_LLM_API_KEY_FILE=~/.codex/auth.json
# JARVIS_LLM_REASONING_EFFORT=xhigh
# JARVIS_LLM_STORE=false
# 命名模型 CCCX-Joe 的独立密钥，对应 config.toml 的 api_key_env。
# CCCX_JOE_API_KEY=中转服务的密钥

# 单次任务的工具步骤预算；达到后会额外进行一次无工具总结
# JARVIS_MAX_STEPS=60

# ── Trace / Permission / Compaction ──────────────────────────
# JARVIS_TRACE_ENABLED=true
# JARVIS_TRACE_INCLUDE_LLM_PAYLOAD=false
# JARVIS_PERMISSION_TIMEOUT_S=60
# JARVIS_COMPACT_THRESHOLD=0
# JARVIS_COMPACT_TOOL_LIMIT=8000
# JARVIS_COMPACT_TOOL_KEEP=4000
# Execution policy belongs in ~/.jarvis/config.toml or the Core's system environment.
# Default: cubesandbox, no expiry. Project .env cannot disable isolation.
# JARVIS_EXECUTION_BACKEND=cubesandbox
# JARVIS_CUBE_CONNECTION_FILE=D:/CubeSandbox/client/connection.env
# JARVIS_SANDBOX_REGISTRY_DIR=~/.jarvis/sandboxes
